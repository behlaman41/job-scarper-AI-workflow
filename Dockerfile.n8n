FROM n8nio/n8n:latest

# Switch to node user and working directory
USER node
WORKDIR /home/node

# Install additional npm packages locally
RUN npm install axios moment-timezone

# Set environment variables
# Credentials come from .env via docker-compose; never bake them into the image.
ENV N8N_HOST=0.0.0.0
ENV N8N_PORT=5678
ENV N8N_PROTOCOL=http
ENV WEBHOOK_URL=http://localhost:5678