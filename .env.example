# Job Scraper Environment Configuration
# Copy this file to .env and fill in your actual values

# Email Configuration (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
# Where the job report is sent (defaults to USER_EMAIL)
EMAIL_TO=

# User Configuration
USER_NAME=Your Name
USER_EMAIL=your-email@example.com

# n8n Configuration
N8N_BASIC_AUTH_USER=admin
# Set a strong password; n8n is only exposed on 127.0.0.1
N8N_BASIC_AUTH_PASSWORD=change-me

# Ollama Configuration
# URL of your Ollama server (from Docker on macOS/Windows: http://host.docker.internal:11434)
OLLAMA_HOST=http://localhost:11434

# Scraper Configuration
SCRAPER_PORT=3000
NODE_ENV=production

# Timezone
TZ=Asia/Kolkata
GENERIC_TIMEZONE=Asia/Kolkata